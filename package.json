{
  "name": "dear-diary",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dear-diary/web",
    "build": "npm run build -w @dear-diary/web",
    "start": "npm run start -w @dear-diary/web",
    "lint": "npm run lint -w @dear-diary/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:crypto": "node scripts/verify-crypto-parity.mjs"
  }
}
